{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "UniFree",
  "version": "2.6.1",
  "identifier": "com.binaryinject.unifree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../app-icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "UniFree v2.6.1",
        "width": 680,
        "height": 520,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
